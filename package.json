{
  "name": "comparador-ca-ceplan-siga",
  "private": true,
  "devDependencies": {
    "concurrently": "^9.0.1",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.10"
  },
  "scripts": {
    "watch:css:prod": "tailwindcss -i ./src/input.css -o ./styles.css --watch --minify",
    "watch:js:prod": "esbuild app.jsx --outfile=app.js --format=iife --jsx-factory=React.createElement --jsx-fragment=React.Fragment --watch --minify",
    "dev:prod": "concurrently -k \"npm run watch:css:prod\" \"npm run watch:js:prod\""
  }
}
